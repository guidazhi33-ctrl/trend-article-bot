# ===== Claude API (記事生成・ニュース翻訳) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ===== OpenAI (DALL-E 3 サムネ生成) =====
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# ===== X (Twitter) API v2 - Free tier =====
X_API_KEY=xxxxxxxxxxxx
X_API_SECRET=xxxxxxxxxxxx
X_ACCESS_TOKEN=xxxxxxxxxxxx
X_ACCESS_TOKEN_SECRET=xxxxxxxxxxxx
X_BEARER_TOKEN=xxxxxxxxxxxx

# ===== GitHub (Issueドラフト発行用) =====
# GitHub Actions上では自動でGITHUB_TOKENが入るのでローカルテスト時のみ設定
GH_TOKEN=ghp_xxxxxxxxxxxx
GH_REPO=yourname/trend-article-bot

# ===== ニュースAPI(任意・無料枠でもOK) =====
NEWSDATA_API_KEY=
# 例: https://newsdata.io/ の無料枠(200リクエスト/日)

# ===== アフィリエイトID =====
A8_AFFILIATE_ID=
MOSHIMO_AFFILIATE_ID=

# Amazon Associates (アソシエイト ID)
# 例: yourname-22  ← Amazon.co.jp の場合は末尾 -22 まで
# 未設定の場合は Amazon リンクは挿入されず、代わりに A8 リンクが使われる。
AMAZON_AFFILIATE_ID=

# ===== LINE 公式アカウント =====
# 友だち追加用 URL(LINE 公式 Manager の「友だち追加用 URL」)
# 例: https://lin.ee/xxxxxxx
# 未設定なら LINE 登録 CTA は記事に挿入されない。
LINE_OFFICIAL_URL=

# ===== 集中カテゴリモード =====
# 初期30日は1カテゴリに絞って「専門家」認識を作るのを推奨。
# stock / fx / crypto のいずれかを指定。空なら全カテゴリ均等。
# 例: FOCUS_CATEGORY=crypto
FOCUS_CATEGORY=

# ===== ブランド設定 =====
# サムネ右下に焼き込まれるブランド名
BRAND_NAME=金融トレンド徹底解剖

# ===== コスト上限ガード =====
# 1 日あたりの API 推定コスト上限 (USD)。超えるとその日のドラフト生成は停止。
# 5.0 = 約 750 円 / 日(月換算 2.2 万円相当)
DAILY_COST_LIMIT_USD=5.0
# 1 ヶ月あたりの上限。超えると月末まで生成停止。
# 実測: 1 日 10 本ペースで月 ≈ $100 必要 → セーフティで $130 (約 2 万円) 推奨
MONTHLY_COST_LIMIT_USD=130.0
